{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Meter",
  "version": "0.3.0",
  "identifier": "com.leoy.agent-meter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4319",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Agent Meter",
        "label": "main",
        "width": 1240,
        "height": 800,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/leoyoul/agent-meter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRjFFMUE4Rjk5QzREODgKUldTSVRaejVxT0h4dzBaY09nV3hUZ3UvUkZJYWVUL0pMSXp0UlBESk9VdXlnL1A2dGFRZE1mUjIK"
    }
  }
}
